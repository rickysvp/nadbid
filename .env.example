# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WalletConnect Project ID (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Monad Testnet RPC URL (optional, uses default if not set)
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# 应用名称
VITE_APP_NAME=NADBID

# ============================================================================
# 智能合约地址（部署后填入，未配置时相关功能显示"合约未部署"）
# ============================================================================

# PASS NFT 合约地址
VITE_CONTRACT_PASS=

# 拍卖合约地址
VITE_CONTRACT_AUCTION=

# 质押合约地址
VITE_CONTRACT_STAKING=

# 分红合约地址
VITE_CONTRACT_DIVIDEND=

# SP-1 注册表合约地址（部署后填入）
VITE_CONTRACT_REGISTRY=0x7212DFbC1D7Ee3AC534C1F2288207e75b8014c3D

# SP-1 工厂合约地址（部署后填入）
VITE_CONTRACT_FACTORY=0x72cc4Cb654Ed919651e7822608380a274e99F63e

# ============================================================================
# X API（后端粉丝验证，主流程为 X OAuth，见 server/x-oauth.ts）
# ============================================================================

# 第三方 X 粉丝验证 API（SocialData.tools）— 备用查询，注册 https://socialdata.tools 后获取
SOCIALDATA_API_KEY=
# X OAuth 2.0（验证 KOL 本人身份）— 在 developer.x.com 创建 App 后获取
# 回调地址必须在 X App 的 User authentication settings 中精确登记
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:3001/api/kol/x-oauth-callback
# OAuth 完成后的前端跳转地址（生产：https://nadbid.fun）
X_FRONTEND_URL=http://localhost:3000
# OAuth state 签名密钥（生产用随机长串）
X_STATE_SECRET=
# KOL 粉丝门槛（测试网 1000，主网正式值）
X_FOLLOWERS_THRESHOLD=1000
