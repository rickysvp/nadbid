VITE_NADBID_AUCTION=0xa4995aabf1910ec713a9b17a0b679e9ef95547ee

# USDC 结算代币（Monad 测试网 Circle 官方地址）
VITE_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
