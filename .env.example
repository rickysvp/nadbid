# ============================================================
# NADBID — 链上拍卖协议环境配置（Monad 测试网）
# ============================================================

# WalletConnect Project ID (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Monad Testnet RPC URL（可选，默认 https://testnet-rpc.monad.xyz）
