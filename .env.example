# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WalletConnect Project ID (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=c111313e8062592e9151a86a383f2994

# Monad Testnet RPC URL (optional, uses default if not set)
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# 应用名称
VITE_APP_NAME=NADBID

# ============================================================================
# 智能合约地址（部署后填入，未配置时相关功能显示"合约未部署"）
# ============================================================================

# PASS NFT 合约地址
VITE_CONTRACT_PASS=

# 拍卖合约地址
VITE_CONTRACT_AUCTION=

# 质押合约地址
VITE_CONTRACT_STAKING=

# 分红合约地址
VITE_CONTRACT_DIVIDEND=

# SP-1 注册表合约地址（2026-09-11 v0.8.3 复审修复后重新部署）
VITE_CONTRACT_REGISTRY=0x08ea3839d47e6d2dfff093be8495102ab4e25aed

# SP-1 工厂合约地址（2026-09-11 v0.8.3 复审修复后重新部署）
VITE_CONTRACT_FACTORY=0xab53835d6c6327d84cfa37656802994c5503d266

# ============================================================================
# X API（后端粉丝验证，主流程为 X OAuth，见 server/x-oauth.ts）
# ============================================================================

# 第三方 X 粉丝验证 API（SocialData.tools）— 备用查询，注册 https://socialdata.tools 后获取
SOCIALDATA_API_KEY=
# X OAuth 2.0（验证 KOL 本人身份）— 在 developer.x.com 创建 App 后获取
# 回调地址必须在 X App 的 User authentication settings 中精确登记
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:3001/api/kol/x-oauth-callback
# OAuth 完成后的前端跳转地址（生产：https://nadbid.fun）
X_FRONTEND_URL=http://localhost:3000
# OAuth state 签名密钥（生产用随机长串）
X_STATE_SECRET=
# KOL 粉丝门槛（测试网 1000，主网正式值）
X_FOLLOWERS_THRESHOLD=1000
# 平台注册签名私钥（P2-2）：X 验证通过后 server 对 (wallet, handle, followers)
# 签发 ECDSA 签名，合约 registerKol 用 setPlatformSigner 设置的公钥验签。
# 私钥的公钥必须通过合约 setPlatformSigner() 配置，且不能与部署钱包私钥相同。
PLATFORM_SIGNER_PRIVATE_KEY=


# ============================================================================
# 新协议 NADBID（USDC 结算链上拍卖）— 部署于 Monad 测试网 chainId 10143
# 部署时间：2026-09-14  main 9a73b8f
# 部署钱包：0x465cc653ac57a31707bf07ea2a89637ea79c334b
# ============================================================================

# NADBIDAuction 拍卖主合约（创建/出价/结算/退款/分红）
VITE_NADBID_AUCTION=0xa4995aabf1910ec713a9b17a0b679e9ef95547ee

# USDC 结算代币（Monad 测试网 Circle 官方地址）
VITE_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
