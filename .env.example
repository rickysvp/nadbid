# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WalletConnect Project ID (https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Monad Testnet RPC URL (optional, uses default if not set)
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# 应用名称
VITE_APP_NAME=NADBID

# ============================================================================
# 智能合约地址（部署后填入，未配置时相关功能显示"合约未部署"）
# ============================================================================

# PASS NFT 合约地址
VITE_CONTRACT_PASS=

# 拍卖合约地址
VITE_CONTRACT_AUCTION=

# 质押合约地址
VITE_CONTRACT_STAKING=

# 分红合约地址
VITE_CONTRACT_DIVIDEND=

# SP-1 注册表合约地址（部署后填入）
VITE_CONTRACT_REGISTRY=0xf17Af005B0F545007A15f3fC9Bc774a06827b68E

# SP-1 工厂合约地址（部署后填入）
VITE_CONTRACT_FACTORY=0x6D36a9993580BeC99BF58aA9a77aE3Fb8DE63B2E

# ============================================================================
# X API（后端粉丝验证，server/verify-twitter.ts）
# ============================================================================

# X API v2 Bearer Token（https://developer.twitter.com/ 申请）
# 未配置时 verify-twitter 接口返回 mock 数据（{ verified: true, followers: 1520000, mock: true }），供前端联调
# 第三方 X 粉丝验证 API（SocialData.tools）— 免官方审核，$0.0002/次，每分钟 3 次免费
# 注册 https://socialdata.tools 后获取；未配置时返回 mock 数据
SOCIALDATA_API_KEY=
# X OAuth 2.0（验证 KOL 本人身份）— 在 developer.x.com 创建 App 后获取
# 回调地址必须在 X App 的 User authentication settings 中精确登记
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:3001/api/kol/x-oauth-callback
# OAuth 完成后的前端跳转地址（生产：https://nadbid.fun）
X_FRONTEND_URL=http://localhost:3000
